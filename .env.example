# Public site URL (no trailing slash). Used for canonical URLs, sitemap, redirects, and auth links.
NEXT_PUBLIC_SITE_URL=https://www.tabwellnesscollective.com

# Search indexing (NFR-009). Leave false everywhere until launch; set true only on the production domain at cutover.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Show "Draft copy" markers on temporary content (true on preview deployments, false in production).
NEXT_PUBLIC_SHOW_DRAFTS=true

# Resend: emails Start Where You Are and contact submissions to info@tabwellnesscollective.com.
RESEND_API_KEY=

# Cloudflare Turnstile: the forms' human check (SEC-013, lib/spam.ts). Free. Leave empty to turn it off.
# Cloudflare's public test keys for local work: site 1x00000000000000000000AA, secret 1x0000000000000000000000000000000AA.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Supabase (My TAB). Required only when config/site.ts → portal.dataSource = "supabase".
# Production client data waits for the portal security gate (CLAUDE.md guardrail 4); HIPAA does not apply (owner ruling 2026-09-28).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (digital programs, cohorts, memberships only; appointments stay in Timely per D-052).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
