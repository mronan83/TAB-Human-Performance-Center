    "clsx": "^2.1.1",
    "next": "^15.5.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "resend": "^6.30.0",
    "stripe": "^22.6.2",
    "zod": "^3.25.76"
